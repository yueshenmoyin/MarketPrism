# MarketPrism server model configuration
AITRADE_LLM_PROVIDER=custom_openai_compatible
AITRADE_CUSTOM_BASE_URL=https://your-gateway.example.com/v1
AITRADE_CUSTOM_API_KEY=
AITRADE_QUICK_THINK_LLM=qwen-plus
AITRADE_DEEP_THINK_LLM=qwen-max
AITRADE_OUTPUT_LANGUAGE=Simplified Chinese
AITRADE_ADVANCED_MODE=false

# MarketPrism auth and server storage
AITRADE_AUTH_USERNAME=admin
AITRADE_AUTH_PASSWORD=
AITRADE_AUTH_USERS_FILE=/etc/aitrade-auth/users.json
AITRADE_DATA_CACHE_DIR=/var/lib/aitrade/data-cache
AITRADE_RESULTS_DIR=/var/lib/aitrade/results

# Optional A-share server precache
AITRADE_PRECACHE_ENABLED=false
AITRADE_PRECACHE_SYMBOLS=600519.SH,000001.SZ
AITRADE_PRECACHE_LOOKBACK_DAYS=120
AITRADE_PRECACHE_INTERVAL_SECONDS=86400

# Direct provider keys are optional. Prefer server-side custom gateway for customer builds.
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=

# Optional: point at a remote Ollama server. When unset, defaults to
# the local instance at http://localhost:11434/v1. Convention follows
# the broader Ollama ecosystem; both the CLI dropdown and programmatic
# client pick this up.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Optional: override DEFAULT_CONFIG without editing code.
# Any AITRADE_* variable below, when set, replaces the matching key
# in aitrade/default_config.py. Values are coerced to bool / int / str.
#AITRADE_MAX_DEBATE_ROUNDS=1
#AITRADE_MAX_RISK_ROUNDS=1
#AITRADE_CHECKPOINT_ENABLED=false
